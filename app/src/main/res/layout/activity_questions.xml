<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".QuestionsActivity">


    <VideoView
        android:id="@+id/backgroundVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/score_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0"
        android:fontFamily="@font/inter_bold"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:background="@drawable/rounded_background"
        android:padding="8dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />


    <TextView
        android:id="@+id/percentage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3"/>

    <ImageView
        android:id="@+id/close_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/close_button"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/robot_completion"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/robot_completion"
        android:layout_marginTop="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/percentage_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/completion_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="400dp"
        app:layout_constraintTop_toBottomOf="@id/robot_completion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/question_text"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/question_text"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/inter_bold"
        android:background="@drawable/gradient_question_background"
        android:gravity="center"
        android:textAlignment="center"
        android:padding="16dp"
        android:maxLines="5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <Button
        android:id="@+id/answer_button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:text="@string/answer_button_1"
        android:background="@drawable/rounded_button_blue"
        app:layout_constraintTop_toBottomOf="@id/question_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_percent="0.8"/>

    <TextView
        android:id="@+id/points_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:text="0"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@+id/answer_button_1"
        app:layout_constraintBottom_toBottomOf="@+id/answer_button_1"
        app:layout_constraintStart_toEndOf="@id/answer_button_1" />

    <Button
        android:id="@+id/answer_button_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:text="@string/answer_button_2"
        android:background="@drawable/rounded_button_blue"
        app:layout_constraintTop_toBottomOf="@id/answer_button_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_percent="0.8"/>

    <TextView
        android:id="@+id/points_text_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:text="0"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@+id/answer_button_2"
        app:layout_constraintBottom_toBottomOf="@+id/answer_button_2"
        app:layout_constraintStart_toEndOf="@id/answer_button_2" />

    <Button
        android:id="@+id/answer_button_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:text="@string/answer_button_3"
        android:background="@drawable/rounded_button_blue"
        app:layout_constraintTop_toBottomOf="@id/answer_button_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_percent="0.8"/>

    <TextView
        android:id="@+id/points_text_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:text="0"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@+id/answer_button_3"
        app:layout_constraintBottom_toBottomOf="@+id/answer_button_3"
        app:layout_constraintStart_toEndOf="@id/answer_button_3" />

    <Button
        android:id="@+id/answer_button_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:text="@string/answer_button_4"
        android:background="@drawable/rounded_button_blue"
        app:layout_constraintTop_toBottomOf="@id/answer_button_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_percent="0.8"/>

    <TextView
        android:id="@+id/points_text_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:text="0"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@+id/answer_button_4"
        app:layout_constraintBottom_toBottomOf="@+id/answer_button_4"
        app:layout_constraintStart_toEndOf="@id/answer_button_4" />

    <VideoView
        android:id="@+id/feedback_video"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/close_feedback_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/close_feedback"
        android:background="@drawable/rounded_button_blue"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/feedback_video"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </LinearLayout>


    <ImageView
        android:id="@+id/progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/answer_button_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>

