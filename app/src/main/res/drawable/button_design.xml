<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="100dp"/>
            <solid android:color="#456892"/> <!-- Color when pressed -->
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape>
            <corners android:radius="100dp"/>
            <solid android:color="#456892"/> <!-- Default button color -->
        </shape>
    </item>
</selector>
